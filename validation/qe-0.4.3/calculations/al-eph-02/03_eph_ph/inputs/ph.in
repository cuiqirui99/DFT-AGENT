DFT Agent electron-phonon coupling
&INPUTPH
  prefix = 'dft_agent',
  outdir = './scratch',
  fildyn = 'dft_agent.dyn',
  fildvscf = 'dft_agent.dvscf',
  electron_phonon = 'interpolated',
  el_ph_sigma = 0.005,
  el_ph_nsigma = 10,
  trans = .true.,
  ldisp = .true.,
  tr2_ph = 1e-14,
  nq1 = 6,
  nq2 = 6,
  nq3 = 6,
/
