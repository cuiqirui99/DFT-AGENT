DFT Agent
&INPUTEPW
  prefix = 'dft_agent',
  outdir = './scratch',
  ep_coupling = .false.,
  elph = .false.,
  epwread = .true.,
  epwwrite = .false.,
  wannierize = .false.,
  eliashberg = .true.,
  liso = .true.,
  laniso = .false.,
  limag = .true.,
  lpade = .false.,
  lacon = .false.,
  lreal = .false.,
  fila2f = 'alpha2f.dat',
  nqstep = 500,
  muc = 0.16,
  wscut = 0.5,
  nsiter = 1000,
  conv_thr_iaxis = 1e-06,
  broyden_beta = 0.3,
  gridsamp = 0,
  nstemp = 4,
  tc_linear = .true.,
  tc_linear_solver = 'lapack',
  nkf1 = 1,
  nkf2 = 1,
  nkf3 = 1,
  nqf1 = 1,
  nqf2 = 1,
  nqf3 = 1,
  temps(1) = 15.0,
  temps(2) = 30.0,
  temps(3) = 45.0,
  temps(4) = 60.0,
/
