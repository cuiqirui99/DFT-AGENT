DFT Agent
&INPUTEPW
  prefix = 'dft_agent',
  outdir = './scratch',
  ep_coupling = .false.,
  elph = .false.,
  epwread = .true.,
  epwwrite = .false.,
  wannierize = .false.,
  eliashberg = .true.,
  liso = .true.,
  laniso = .false.,
  limag = .true.,
  lpade = .false.,
  lacon = .false.,
  lreal = .false.,
  fila2f = 'alpha2f.dat',
  nqstep = 1999,
  muc = 0.1,
  wscut = 0.2,
  nsiter = 500,
  conv_thr_iaxis = 1e-06,
  broyden_beta = 0.2,
  gridsamp = 0,
  nstemp = 6,
  tc_linear = .false.,
  tc_linear_solver = 'lapack',
  nkf1 = 1,
  nkf2 = 1,
  nkf3 = 1,
  nqf1 = 1,
  nqf2 = 1,
  nqf3 = 1,
  temps(1) = 0.5,
  temps(2) = 1.0,
  temps(3) = 2.0,
  temps(4) = 3.0,
  temps(5) = 4.0,
  temps(6) = 5.0,
/
