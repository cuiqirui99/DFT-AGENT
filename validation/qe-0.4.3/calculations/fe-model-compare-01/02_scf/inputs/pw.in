&CONTROL
  calculation = 'scf',
  prefix = 'dft_agent',
  outdir = './scratch',
  pseudo_dir = './pseudo',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'high',
/
&SYSTEM
  ibrav = 0,
  nat = 2,
  ntyp = 2,
  ecutwfc = 90.0,
  ecutrho = 1080.0,
  input_dft = 'PBE',
  nspin = 2,
  starting_magnetization(1) = 0.5,
  starting_magnetization(2) = -0.5,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.01,
/
&ELECTRONS
  conv_thr = 1e-08,
  electron_maxstep = 120,
/
ATOMIC_SPECIES
FeA 55.845 Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
FeB 55.845 Fe.pbe-spn-kjpaw_psl.0.2.1.UPF
CELL_PARAMETERS angstrom
2.86 0 2e-16
-2e-16 2.86 2e-16
0 0 2.86
ATOMIC_POSITIONS crystal
FeA 0 0 0
FeB 0.5 0.5 0.5
K_POINTS automatic
9 9 9 0 0 0
