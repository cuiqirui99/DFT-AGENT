&CONTROL
  calculation = 'scf',
  prefix = 'dft_agent',
  outdir = './scratch',
  pseudo_dir = './pseudo',
  tprnfor = .true.,
  tstress = .true.,
  verbosity = 'high',
/
&SYSTEM
  ibrav = 0,
  nat = 2,
  ntyp = 1,
  ecutwfc = 60.0,
  ecutrho = 480.0,
  input_dft = 'PBE',
  noncolin = .true.,
  lspinorb = .true.,
  occupations = 'fixed',
  nbnd = 16,
/
&ELECTRONS
  conv_thr = 1e-10,
  electron_maxstep = 120,
  diagonalization = 'cg',
  diago_cg_maxiter = 200,
  diago_full_acc = .true.,
/
ATOMIC_SPECIES
Si 28.0855 Si.rel-pbe-n-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
3.3251823242321 0 1.91979491
1.1083941080774 3.1350119601949 1.91979491
0 0 3.83958982
ATOMIC_POSITIONS crystal
Si 0 0 0
Si 0.25 0.25 0.25
K_POINTS automatic
8 8 8 0 0 0
