DFT Agent
&INPUTEPW
  prefix = 'dft_agent',
  outdir = './scratch',
  ep_coupling = .false.,
  elph = .false.,
  epwread = .true.,
  epwwrite = .false.,
  wannierize = .false.,
  eliashberg = .true.,
  liso = .true.,
  laniso = .false.,
  limag = .true.,
  lpade = .false.,
  lacon = .false.,
  lreal = .false.,
  fila2f = 'alpha2f.dat',
  nqstep = 1999,
  muc = 0.1,
  wscut = 0.2,
  nsiter = 1000,
  conv_thr_iaxis = 1e-06,
  broyden_beta = 0.2,
  gridsamp = 0,
  nstemp = 2,
  tc_linear = .false.,
  tc_linear_solver = 'lapack',
  temps(1) = 0.5,
  temps(2) = 1.0,
/
